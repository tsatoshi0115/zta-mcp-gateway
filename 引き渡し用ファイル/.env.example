# ==============================================================================
# ZTA MCP Gateway - 環境変数設定例
# ==============================================================================
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# ゲートウェイ設定ファイルの配置パス
GATEWAY_CONFIG_PATH=/app/config/gateway-config.yaml

# ------------------------------------------------------------------------------
# 1. ゲートウェイ側 JWT & OAuth 2.1 サーバー署名キー設定
# ------------------------------------------------------------------------------
# Access Token (JWT) 署名・検証用シークレットキー（本番環境では推測不可能な安全な文字列に変更してください）
GATEWAY_JWT_SECRET=super-secret-key-change-in-production-2026

# Access Token 有効期間（例: 15m, 1h, 2h - デフォルト: 1h）
GATEWAY_ACCESS_TOKEN_EXPIRES_IN=1h

# Refresh Token 署名・検証用シークレットキー（未指定時は GATEWAY_JWT_SECRET を使用）
GATEWAY_REFRESH_SECRET=super-secret-refresh-key-change-in-production-2026

# Refresh Token 有効期間（例: 7d, 30d - デフォルト: 7d）
GATEWAY_REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 2. ゲートウェイ側 認証クライアント定義 (環境変数からの直接定義・上書き)
# ------------------------------------------------------------------------------
# gateway-config.yaml に定義する代わりに、環境変数経由でクライアントを追加・上書き可能です。
# ロールはカンマ区切りで複数指定可能 (例: analyst,operator)
GATEWAY_CLIENT_ID=zta-agent-client
GATEWAY_CLIENT_SECRET=agent-client-secret-2026
GATEWAY_CLIENT_ROLES=analyst

# ------------------------------------------------------------------------------
# 3. クライアント側（AIエージェント / テスト / UI連携）接続設定
# ------------------------------------------------------------------------------
# ※ セキュリティ強化のため、従来の「静的JWT直書き」は廃止されました。
# ※ 以下の Client ID / Secret を定義し、/oauth/token から Access Token と Refresh Token を取得・更新します。
ZTA_GATEWAY_URL=http://localhost:8080
ZTA_TOKEN_URL=http://localhost:8080/oauth/token
ZTA_CLIENT_ID=macosui-analyst
ZTA_CLIENT_SECRET=analyst-secret-2026
